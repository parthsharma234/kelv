# Optional demo-only feedback path. Do not expose an OpenAI key in production.
VITE_OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs setup script only. Do not expose this with a VITE_ prefix.
ELEVENLABS_API_KEY=your_private_elevenlabs_api_key_here

# ElevenLabs Configuration (live interview agent)
VITE_ELEVENLABS_AGENT_ID=your_public_elevenlabs_agent_id_here

# Instructions:
# 1. Copy this file to .env.local
# 2. Fill in the ElevenLabs values
# 3. Run: npm run setup:elevenlabs-agent
#    - This creates the Kelv agent through the ElevenLabs API.
#    - Recommended voice model for the agent: eleven_flash_v2.
