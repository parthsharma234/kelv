# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI Configuration (Legacy - for OpenAI Realtime)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Hume AI Configuration (Primary - for EVI interviews)
VITE_HUME_API_KEY=your_hume_api_key_here
VITE_HUME_CONFIG_ID=your_hume_config_id_here

# Instructions:
# 1. Copy this file to .env.local
# 2. Fill in your actual API keys
# 3. For Hume AI:
#    - Get API key from https://platform.hume.ai/settings
#    - Create an EVI config at https://platform.hume.ai/evi/configs
#    - Use your custom voice "Kelv" in the config
#    - Copy the config ID and paste it above
